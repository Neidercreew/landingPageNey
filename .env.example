# Copia este archivo como .env SOLO para pruebas locales con `netlify dev`.
# En producción estas variables se configuran en Netlify:
# Site configuration -> Environment variables. Nunca subas el .env a GitHub.

# Airtable (token personal con permiso data.records:write sobre la base)
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_CONTACTS_TABLE=Contacts
AIRTABLE_ANALYTICS_TABLE=Analytics
# Opcional: base separada para analytics (si se omite, usa AIRTABLE_BASE_ID)
AIRTABLE_ANALYTICS_BASE_ID=

# EmailJS (Account -> General y Account -> Security)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=tu-correo@ejemplo.com

# Google reCAPTCHA v3 (la Site Key va en js/script.js; aquí solo la secreta)
RECAPTCHA_SECRET_KEY=6LfXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Opcional: puntaje mínimo para aceptar el envío (por defecto 0.5)
RECAPTCHA_MIN_SCORE=0.5